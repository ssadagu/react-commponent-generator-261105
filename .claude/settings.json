{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*credentials*)",
      "Edit(**/*secret*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*credentials*)",
      "Write(**/*secret*)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Bash(cat *.env*)",
      "Bash(cat *credentials*)",
      "Bash(cat *secret*)",
      "Bash(grep * *.env*)",
      "Bash(source *.env*)"
    ]
  }
}
